# Copy to .env and fill in. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATABASE_URL="file:./dev.db"
SESSION_SECRET="at-least-32-random-characters"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="pick-a-strong-one"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Mapbox (public map tiles + geocoding) ---
# Create at https://account.mapbox.com/access-tokens/ — restrict it by URL before deploying.
# Deliberately NOT NEXT_PUBLIC_: that prefix inlines at build time. Passed as a prop from app/page.tsx.
MAPBOX_TOKEN=""

# --- Google Places API (New) — business ingestion ---
# Enable "Places API (New)" in Google Cloud, then restrict the key to that API.
GOOGLE_PLACES_API_KEY=""

# --- Google Gemini — scoring + photo moderation ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Community photo auto-publish threshold, 0-1. Set to 1 to auto-publish nothing
# (everything waits in the admin queue) until you trust the model.
PHOTO_AUTOPUBLISH_CONFIDENCE="0.85"
